<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ejercicios UT3 - PMDM"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnEjercicio1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 1: Validar URL" />

    <Button
        android:id="@+id/btnEjercicio2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 2: Navegación Retrasada" />

    <Button
        android:id="@+id/btnEjercicio3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 3: LinearLayouts Anidados" />

    <Button
        android:id="@+id/btnEjercicio4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 4: FrameLayout Grid" />

    <Button
        android:id="@+id/btnEjercicio5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 5: Calculadora TableLayout" />

    <Button
        android:id="@+id/btnEjercicio6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio 6: Perfil ConstraintLayout" />

</LinearLayout>